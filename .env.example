# Minecraft LLM Agent Environment Variables
# Copy to .env and adjust as needed

# Server Authentication (if using Microsoft account instead of offline)
MC_AUTH=offline
MC_USERNAME=AIAgentBot
MC_PASSWORD=

# LLM API Keys (LM Studio does not require a key)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Port for optional Prismarine web viewer (default 3000)
VIEWER_PORT=3000
