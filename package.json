{
  "name": "minecraft-llm-agent",
  "version": "1.0.0",
  "description": "Minecraft LLM Agent for Java 1.21.6 using Mineflayer and TypeScript",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsx src/main.ts",
    "auto": "tsx src/automation.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:mock": "vitest run tests/scenario_loop.test.ts tests/scenario_runner.test.ts tests/gather_logs_milestone.test.ts tests/action_manifest.test.ts",
    "test:manifest": "tsx scripts/validate_manifest.ts",
    "observer:build": "tsx scripts/build_observer.ts",
    "test:live": "tsx scripts/run_live_scenarios.ts",
    "test:campaign": "tsx scripts/run_campaign.ts",
    "report:coverage": "tsx scripts/generate_coverage_report.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "llm",
    "agent",
    "ai",
    "lm-studio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "minecraft-data": "3.117.0",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "vec3": "0.1.10",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "vitest": "^2.0.5"
  }
}
